{
  "name": "sub3-vault",
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["generativelanguage.googleapis.com"]
    },
    "reddit": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },

  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "tiempo-viaje",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/example-form"
      },
      {
        "label": "Rank Settings",
        "description": "Configure ranking levels, thresholds, and flair",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/rank-settings"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "triggers": {
    "onModAction": "/internal/triggers/on-mod-action",
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onCommentSubmit": "/internal/triggers/on-comment-submit"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "sub_vault_dev"
  }
}